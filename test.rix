fun printf(fmt: *u8, _: ...) : i32;

fun main(argc: i32, argv: **u8) : i32 {
    if argc > 1 {
        printf("Multiple arguments provided. First argument: %s\n", argv[0]);
    } else if argc == 1 {
        printf("One argument provided.\n");
    } else {
        printf("No arguments provided.\n");
    }

    var i = 0;
    while i < argc {
        printf("Argument %d: %s\n", i, argv[i]);
        i = i + 1;
    }

    printf("Square of argc: %d\n", square(argc));

    return square(0);
}

fun square(n: i32) : i32 {
    return n * n;
}
